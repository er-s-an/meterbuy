# Server-only. Never prefix these with NEXT_PUBLIC_.
# Copy to .env.local. This app also reads .env.burner.local when that file exists.
# Do not commit either file. The private key is a Sepolia burner, still a secret.

TELEGRAPH_EVM_PRIVATE_KEY=
TELEGRAPH_EVM_ADDRESS=
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com/engine
TELEGRAPH_DAEMON_URL=https://devnode.telegraphprotocol.com
EVM_NETWORK=eip155:11155111
USDC_SEPOLIA=0xcc194e1a843B658526D0D5C431f670028582Ae17
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Fund the address in TELEGRAPH_EVM_ADDRESS with Sepolia ETH, then mint test USDC:
# cast send $USDC_SEPOLIA "mint(address,uint256)" $TELEGRAPH_EVM_ADDRESS 10000000 \
#   --rpc-url $SEPOLIA_RPC_URL --private-key $TELEGRAPH_EVM_PRIVATE_KEY
# 10000000 base units = 10 USDC. ETH is gas for the mint. x402 exact settlement is
# signed by the burner; the facilitator broadcasts it. The burner still needs a USDC balance.
